# Instellingen voor Colomarkt+. Het installatiescript maakt hiervan /etc/colomarkt.env.

# Code die elk toestel één keer moet ingeven (deel ze enkel met personeel).
# Verander je de code, dan moeten alle toestellen ze opnieuw ingeven.
TOEGANGSCODE=kies-een-lange-code

# Wachtwoord van de systeembeheerder (beheersmodule in de app: gebruikers, toestellen, back-ups).
# Het installatiescript vult het in. Wijzigt de beheerder het in de app, dan geldt dat nieuwe wachtwoord.
BEHEER_WACHTWOORD=

# Poort waarop de app intern luistert (Caddy zet er https voor).
POORT=3000
ADRES=127.0.0.1

# Waar de gegevens en de dagelijkse back-ups staan.
DATA_MAP=/var/lib/colomarkt

# Aantal dagelijkse back-ups dat bewaard blijft.
BACKUP_DAGEN=30

# Optioneel: sleutel van de Claude API (console.anthropic.com) om leverbonnen,
# facturen en recepten met een foto te laten lezen. Leeg = die knoppen staan uit.
ANTHROPIC_API_KEY=
# Model voor foto's en recepten (standaard claude-opus-5-5) en voor korte tekst (standaard claude-haiku-5-5).
AI_MODEL=claude-opus-5-5
AI_MODEL_SNEL=claude-haiku-5-5

# Optioneel: Claude-taken die de app start (zie LEESMIJ.md, "Webshop en prijzen").
# Token per taak: claude.ai/code/routines › taak › Bewerken › API-trigger › Generate token.
ROUTINE_TOKEN_WEBSHOP=
ROUTINE_TOKEN_BESTELSTATUS=
ROUTINE_TOKEN_PRIJZEN=

# Sleutel waarmee die taken catalogi en bestelstatus terugsturen (het installatiescript vult ze in).
SERVER_SLEUTEL=
